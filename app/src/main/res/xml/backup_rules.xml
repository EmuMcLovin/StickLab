<?xml version="1.0" encoding="utf-8"?><!--
   Android-Sicherung bis Android 11 (data_extraction_rules.xml gilt ab Android 12).
   Das gemerkte Original bleibt draußen: Es gehört zu genau einer Installation auf genau einem Gerät. Käme es
   aus einer Sicherung zurück, würde "Restore everything" fremde Werte setzen (OFFENE_FRAGEN 2).
   Dateiname = AppStorage.AppFile.ORIGINAL_VALUES, geprüft von BackupRulesTest. Alles andere darf mit.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="original_values.xml" />
</full-backup-content>
