<?xml version="1.0" encoding="utf-8"?><!--
   Android-Sicherung ab Android 12, in die Cloud und beim Umzug auf ein neues Gerät.
   Das gemerkte Original bleibt draußen, Grund siehe backup_rules.xml. Alles andere darf mit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="original_values.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="original_values.xml" />
    </device-transfer>
</data-extraction-rules>
